# {{ ansible_managed }}
# Every instance serves its GUI on a private Unix socket, never a TCP port: any
# local user can administer a passwordless loopback GUI. See
# docs/syncthing-server.md.
[Service]
RuntimeDirectory=syncthing-%i
RuntimeDirectoryMode=0750
Environment=STGUIADDRESS=unix:///run/syncthing-%i/gui.sock
